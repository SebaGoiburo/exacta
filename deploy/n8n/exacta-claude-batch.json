    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One answer per job, as the site expects it. A job missing from the results comes back as a failure.\nconst jobs = $('Verificar firma').first().json.jobs;\nconst byId = {};\nfor (const line of String($input.first().json.data ?? '').split('\\n')) {\n  if (!line.trim()) continue;\n  try {\n    const r = JSON.parse(line);\n    byId[r.custom_id] = r.result;\n  } catch (e) {}\n}\nreturn jobs.map((j) => {\n  const result = byId[j.jobId.replace(':', '-')];\n  const response = result?.type === 'succeeded'\n    ? result.message\n    : { error: { message: result?.type === 'errored' ? (result.error?.error?.message || 'El pedido falló.') : 'El lote venció sin respuesta.' } };\n  return { json: { jobId: j.jobId, response } };\n});"
      },
      "id": "b7a10000-0013-4b01-9b01-batch0000013",
      "name": "Separar resultados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Without a batch there's nothing to wait for: each job is told, so it doesn't look busy.\nconst reason = $input.first().json.error?.message || $input.first().json.error || 'No se pudo usar el envío por lotes.';\nreturn $('Verificar firma').first().json.jobs.map((j) => ({ json: { jobId: j.jobId, response: { error: { message: String(reason).slice(0, 200) } } } }));"
      },
      "id": "b7a10000-0014-4b01-9b01-batch0000014",
      "name": "Avisar que falló",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// The site only accepts results signed with the shared secret.\nconst crypto = require('crypto');\nconst body = JSON.stringify({ jobId: $json.jobId, response: $json.response });\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(body).digest('hex');\nreturn { json: { body, signature } };"
      },
      "id": "b7a10000-0015-4b01-9b01-batch0000015",
