    {
      "id": "8d3f1c30-0000-4000-8000-000000000207",
      "name": "Firmar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, -100],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The site only accepts results signed with the shared secret.\nconst crypto = require('crypto');\nconst jobId = $('Verificar firma').first().json.jobId;\nconst body = JSON.stringify({ jobId, response: $input.first().json });\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      }
    },
