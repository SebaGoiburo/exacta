    {
      "id": "8d3f1c30-0000-4000-8000-000000000202",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Only the site can start a run: each one costs money. The signature covers the exact bytes received.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst received = Buffer.from(item.json.headers?.['x-exacta-signature'] ?? '');\nconst expected = Buffer.from('sha256=' + crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(raw).digest('hex'));\nif (received.length !== expected.length || !crypto.timingSafeEqual(received, expected)) return [{ json: { valid: false } }];\nreturn [{ json: { valid: true, ...JSON.parse(raw.toString('utf8')).data } }];"
      }
    },
    {
      "id": "8d3f1c30-0000-4000-8000-000000000203",
      "name": "¿Firma válida?",
