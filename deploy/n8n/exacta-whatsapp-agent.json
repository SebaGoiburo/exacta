    {
      "id": "7c2f0b20-0000-4000-8000-000000000106",
      "name": "Verificar y extraer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rejects what Meta didn't sign. Status updates are ignored: only messages from people go on.\nconst crypto = require('crypto');\nconst secret = $env.META_APP_SECRET;\nif (!secret) return [];\nconst item = $input.first();\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst received = Buffer.from(item.json.headers?.['x-hub-signature-256'] ?? '');\nconst expected = Buffer.from('sha256=' + crypto.createHmac('sha256', secret).update(raw).digest('hex'));\nif (received.length !== expected.length || !crypto.timingSafeEqual(received, expected)) return [];\n\n// Voice notes are downloaded next; photos and files are marked so the site answers them; the rest is described.\nconst FILES = ['image', 'video', 'document', 'sticker'];\nconst LABELS = { location: 'una ubicación', contacts: 'un contacto' };\nconst out = [];\nfor (const entry of JSON.parse(raw.toString('utf8')).entry ?? []) {\n  for (const change of entry.changes ?? []) {\n    const value = change.value ?? {};\n    for (const m of value.messages ?? []) {\n      const kind = m.type === 'audio' ? 'audio' : FILES.includes(m.type) ? 'archivo' : 'texto';\n      const caption = m.image?.caption ?? m.video?.caption ?? m.document?.caption ?? '';\n      const text = m.text?.body ?? m.button?.text ?? m.interactive?.button_reply?.title ?? m.interactive?.list_reply?.title\n        ?? (kind === 'archivo' ? caption : kind === 'audio' ? '' : `[La persona envió ${LABELS[m.type] ?? 'un mensaje'} que no podés ver. Pedile que lo escriba.]`);\n      out.push({ json: {\n        waId: m.from,\n        waMessageId: m.id,\n        text,\n        kind,\n        mediaId: m.audio?.id ?? null,\n        mimeType: m.audio?.mime_type ?? null,\n        phoneNumberId: value.metadata?.phone_number_id,\n        profileName: value.contacts?.find((c) => c.wa_id === m.from)?.profile?.name ?? value.contacts?.[0]?.profile?.name,\n      } });\n    }\n  }\n}\nreturn out;"
      }
    },
