      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Adds the voice note to the message as base64. If Meta didn't give it, the site hands the chat to a person.\nconst message = $('¿Es un audio?').item.json;\nlet audio = null;\nconst binary = $input.item.binary?.data;\nif (binary) {\n  try {\n    const buffer = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\n    audio = { data: buffer.toString('base64'), mimeType: binary.mimeType || message.mimeType || 'audio/ogg' };\n  } catch (e) {}\n}\nreturn { json: { ...message, audio } };"
