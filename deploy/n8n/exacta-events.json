    {
      "id": "6b1f0a10-0000-4000-8000-000000000002",
      "name": "Verificar firma",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Rejects anything not signed by the site. The signature covers the exact bytes received.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst received = Buffer.from(item.json.headers?.['x-exacta-signature'] ?? '');\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = Buffer.from('sha256=' + crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(raw).digest('hex'));\nconst valid = received.length === expected.length && crypto.timingSafeEqual(received, expected);\nif (!valid) return [{ json: { valid: false } }];\nconst body = JSON.parse(raw.toString('utf8'));\nreturn [{ json: { valid: true, event: body.event, sentAt: body.sentAt, data: body.data } }];"
      }
    },
    {
      "id": "6b1f0a10-0000-4000-8000-000000000003",
      "name": "¿Firma válida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "parameters": {
