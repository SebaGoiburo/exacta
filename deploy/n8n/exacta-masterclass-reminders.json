{
  "name": "Exacta · Recordatorios de masterclass",
  "id": "exactaMasterclass1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "c4a10000-0001-4c01-9c01-master000001",
      "name": "Cada 10 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Signs the body so the site knows this came from n8n.\nconst crypto = require('crypto');\nconst body = JSON.stringify({ step: 'reminders', at: new Date().toISOString() });\nconst signature = 'sha256=' + crypto.createHmac('sha256', $env.N8N_WEBHOOK_SECRET).update(body).digest('hex');\nreturn [{ json: { body, signature } }];"
      },
      "id": "c4a10000-0002-4c01-9c01-master000002",
      "name": "Firmar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://web:3000/api/masterclass/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-exacta-signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c4a10000-0003-4c01-9c01-master000003",
      "name": "Mandar recordatorios",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    }
  ],
  "connections": {
    "Cada 10 minutos": {
      "main": [[{ "node": "Firmar pedido", "type": "main", "index": 0 }]]
    },
    "Firmar pedido": {
      "main": [[{ "node": "Mandar recordatorios", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": true,
  "pinData": {}
}
